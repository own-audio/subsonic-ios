    "Show" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit"
          }
        }
      }
    },
    "Shows what's playing and counts a song once you've heard half of it, or four minutes. The server can pass this on to Last.fm or ListenBrainz if you've set that up there." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukazuje, co hraje, a započítá skladbu, jakmile uslyšíte její polovinu nebo čtyři minuty. Server to může předávat dál na Last.fm nebo ListenBrainz, pokud to tam máte nastavené."
          }
        }
      }
    },
    "Shuffle" : {
      "localizations" : {
